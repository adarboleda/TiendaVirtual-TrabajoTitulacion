# Variables de entorno para producción
# Copiar este archivo a .env y configurar valores reales

# Stripe Payment Gateway
STRIPE_API_KEY=sk_test_tu_clave_secreta_aqui
STRIPE_WEBHOOK_SECRET=whsec_tu_webhook_secret_aqui

# MySQL (opcional, usar si cambias las credenciales)
MYSQL_ROOT_PASSWORD=admin
MYSQL_USER=admin
MYSQL_PASSWORD=admin

# Puerto de exposición del frontend
FRONTEND_PORT=3000

# Puertos de microservicios (cambiar si hay conflictos)
EUREKA_PORT=8761
PRODUCTO_PORT=8081
INVENTARIO_PORT=8082
VENTAS_PORT=8083
